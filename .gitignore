# ---------------------------------------------------------------------------
# Este repositorio es el CODIGO y los DATOS que acompanan al articulo.
# El articulo, la correspondencia con la revista y el material de trabajo se
# quedan en disco pero fuera del control de versiones.
# ---------------------------------------------------------------------------

# El manuscrito y todo lo que lo rodea: fuente LaTeX, PDF compilado, cover
# letter, envios anteriores (IJACSA, EMA/Springer, Remote Sensing/MDPI) con sus
# respuestas a revisores, y las figuras y metricas previas a la auditoria.
#
# Un PDF del articulo aqui solo crea confusion sobre cual es la version
# vigente, y la cover letter es correspondencia con el editor. Compartir el
# preprint no infringe la politica de Elsevier: es una decision nuestra.
manuscript/

# Notas internas de trabajo y herramientas de asistencia a la escritura.
memory/
.agents/
skills-lock.json

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.env
.env.*
.venv/

# Datos crudos y pesados. El analisis arranca de data/processed/matchups_*.csv,
# que si van en el repo; el registro in-situ de IMARPE no se redistribuye aqui.
data/processed/*.npy
data/processed/*.pkl
data/external_validation/*.csv
data/external_validation/*.zip

# Modelos entrenados (los regenera el pipeline)
results/models/*.joblib
results/models/*.pkl
results/models/*.pt

# IDE / SO
*.DS_Store
Thumbs.db
logs/

# cache de la extraccion de p11 (26 MB, regenerable con Earth Engine)
data/processed/window_sensitivity_raw.csv
