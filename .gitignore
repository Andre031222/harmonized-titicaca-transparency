# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.env
.env.*

# Data — large/raw files (available on Zenodo upon acceptance)
data/processed/*.npy
data/processed/*.pkl
data/external_validation/*.csv
data/external_validation/*.zip

# Trained models (regenerated by scripts/18_results_and_figures.py)
results/models/*.joblib
results/models/*.pkl
results/models/*.pt

# Reference PDFs (copyrighted — not for public distribution)
manuscript/References/*.pdf

# LaTeX auxiliary files (auto-generated)
manuscript/*.aux
manuscript/*.log
manuscript/*.out
manuscript/*.toc
manuscript/*.synctex.gz
manuscript/*.fls
manuscript/*.fdb_latexmk
manuscript/*.blg
manuscript/*.bbl

# Submission package (assembled locally for the journal)
manuscript/submission/

# Internal working notes (not for public distribution)
memory/

# IDE / OS
*.DS_Store
Thumbs.db
logs/

# Archived manuscript PDFs (superseded; .tex kept, PDFs rebuildable)
manuscript/_archive/**/*.pdf

# subproductos de LaTeX de la cover letter
manuscript/jglr/cover_letter.aux
manuscript/jglr/cover_letter.log

# Envios anteriores (IJACSA, EMA/Springer, Remote Sensing/MDPI), sus cartas de
# presentacion, respuestas a revisores y las figuras previas a la auditoria.
# Se conservan en disco como historial interno; no forman parte del repo
# publico que acompana al articulo.
manuscript/_archive/

# Skills de asistencia a la escritura: herramienta de trabajo, no del estudio.
.agents/

# subproductos de pdflatex/bibtex del manuscrito (el .bbl se conserva: Elsevier lo pide)
manuscript/jglr/*.aux
manuscript/jglr/*.log
manuscript/jglr/*.blg
manuscript/jglr/*.spl
manuscript/jglr/*.out
# documentacion y plantillas de elsarticle: solo hacen falta el .cls y el .bst
manuscript/jglr/template/
# tooling
skills-lock.json
