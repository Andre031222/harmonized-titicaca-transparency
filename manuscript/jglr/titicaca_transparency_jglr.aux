\newlabel{sec:shap}{{3.7}{23}{}{subsection.3.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Conformal prediction intervals under campaign-blocked validation. (a) Empirical versus nominal coverage: marginally calibrated across the 50--95\% range. (b) The 90\% interval against the measured value. (c) Coverage conditional on measured transparency. Because split conformal uses a single global residual quantile, the interval width is constant ($\approx $6.12~m) and cannot adapt, so the marginal guarantee is bought by over-covering in the middle of the range and under-covering at both extremes.}}{24}{}\protected@file@percent }
\newlabel{fig:unc}{{6}{24}{}{figure.6}{}}
\def\@LN@column{1}
