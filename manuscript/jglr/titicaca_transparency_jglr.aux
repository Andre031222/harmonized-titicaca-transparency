\@writefile{toc}{\contentsline {section}{\numberline {Appendix~A}Supplementary Figures and Tables}{26}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {A.2}{\ignorespaces Effect of the \citet  {Roy2016} OLI$\rightarrow $MSI transform over Lake Titicaca water. Native OLI is the Collection-2 surface reflectance recovered by inverting the transform. Reflectance is dimensionless.}}{26}{}\protected@file@percent }
\newlabel{tab:roy}{{A.2}{26}{}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.5}{\ignorespaces What the dataset actually contains. (a) Match-ups by year and month; three years have no campaign at all, so a hold-out described as ``2022--2024'' contains only 2022 and 2024. (b) Seasonal coverage: zero match-ups in the wet season, when blooms occur in Bah\'ia de Puno. (c) Secchi distribution by trophic zone; the reference measurement is quantized at roughly half a metre.}}{27}{}\protected@file@percent }
\newlabel{fig:inventory}{{A.5}{27}{}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.3}{\ignorespaces Water-specific LS$\rightarrow $S2 recalibration fitted on 270{} paired station--date observations, of the form $\rho _{\mathrm  {S2}} = a + b\,\rho _{\mathrm  {LS,Roy}}$.}}{28}{}\protected@file@percent }
\newlabel{tab:localcoef}{{A.3}{28}{}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.6}{\ignorespaces Diagnosing the blocking unit. (a) Null models evaluated under campaign-blocked folds: only the campaign-mean null collapses, so only campaign blocking is doing work. (b) Out-of-fold $R^2$ under each validation design and under extrapolation to an unseen trophic zone. That station blocking matches the random split is not evidence of no leakage; it is evidence that station blocking retains nothing.}}{29}{}\protected@file@percent }
\newlabel{fig:val}{{A.6}{29}{}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.7}{\ignorespaces Conformal prediction intervals under campaign-blocked validation. (a) Empirical versus nominal coverage: marginally calibrated across the 50--95\% range. (b) The 90\% interval against the measured value. (c) Coverage conditional on measured transparency. Because split conformal uses a single global residual quantile, the interval width is constant ($\approx $6.12~m) and cannot adapt, so the marginal guarantee is bought by over-covering in the middle of the range and under-covering at both extremes.}}{30}{}\protected@file@percent }
\newlabel{fig:unc}{{A.7}{30}{}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.8}{\ignorespaces Transparency trends and their fragility. (a) Annual median in-situ transparency by zone over the full 2011--2024 record, with Mann--Kendall/Sen statistics; no trend is significant. (b) The same test with different start years: beginning the series in 2013, the lowest-median year on record, turns two zones significantly positive.}}{31}{}\protected@file@percent }
\newlabel{fig:trends}{{A.8}{31}{}{figure.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.4}{\ignorespaces Head-to-head benchmark, campaign-blocked GroupKFold, $n=812$.}}{32}{}\protected@file@percent }
\newlabel{tab:bench}{{A.4}{32}{}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.5}{\ignorespaces Model selection under nested cross-validation (Optuna inside an inner campaign-blocked split of each outer training partition). Selected configurations; the full grid is in the repository.}}{33}{}\protected@file@percent }
\newlabel{tab:model}{{A.5}{33}{}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.6}{\ignorespaces Out-of-fold error by trophic zone, campaign-blocked validation.}}{33}{}\protected@file@percent }
